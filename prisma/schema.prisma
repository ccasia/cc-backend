generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                String                             @id @unique @default(cuid())
  email                             String                             @unique @db.VarChar(255)
  password                          String?                            @db.VarChar(255)
  createdAt                         DateTime                           @default(now())
  name                              String?                            @db.VarChar(255)
  photoURL                          String?                            @db.VarChar(255)
  country                           String?                            @db.VarChar(100)
  phoneNumber                       String?                            @db.VarChar(100)
  updatedAt                         DateTime?                          @updatedAt
  status                            Status                             @default(pending)
  eventId                           String?
  role                              RoleEnum
  photoBackgroundURL                String?                            @db.VarChar(255)
  xeroRefreshToken                  String?
  updateRefershToken                DateTime?
  googleId                          String?                            @unique
  city                              String?                            @db.VarChar(100)
  hasSubmittedKWSP                  Boolean                            @default(false)
  isActive                          Boolean                            @default(true)
  isKWSPCampaign                    Boolean?                           @default(false)
  isVerified                        Boolean                            @default(false)
  emailVerificationId               String?                            @unique
  referralCode                      String?                            @db.VarChar(50)
  mediaKitMandatory                 Boolean                            @default(false)
  activatedAt                       DateTime?
  passwordSetAt                     DateTime?
  twoFactorSecret                   String?
  deletedAt                         DateTime?
  appleEmail                        String?                            @db.VarChar(255)
  appleId                           String?                            @unique
  appleRefreshToken                 String?
  appleUnlinkedAt                   DateTime?
  googleEmail                       String?                            @db.VarChar(255)
  googleUnlinkedAt                  DateTime?
  isPhoneVerified                   Boolean                            @default(false)
  appleAudience                     String?
  hasAcceptedTermsAndPrivacy        Boolean                            @default(false)
  lastSeenReleaseNoteAt             DateTime?
  admin                             Admin?
  agreementTemplate                 AgreementTemplate[]
  blockedBrand                      BlockedBrand[]
  Board                             Board?
  BookMarkCampaign                  BookMarkCampaign[]
  bookMarkedBy                      BookMarkCreator[]                  @relation("BookMarkCreatorTarget")
  bookMarkCreator                   BookMarkCreator[]                  @relation("BookMarkCreatorOwner")
  bookMarkCreatorLists              BookMarkCreatorList[]
  bugs                              Bugs[]
  campaignCreationDrafts            CampaignCreationDraft[]
  campaignCreationDraftUploadLeases CampaignCreationDraftUploadLease[]
  campaignFlag                      CampaignFlag[]
  campaignLogs                      CampaignLog[]
  CampaignTaskAdmin                 CampaignTaskAdmin[]
  client                            Client?
  commentAgreements                 CommentAgreement[]
  creator                           Creator?
  creatorAchievements               CreatorAchievement[]
  creatorAgreement                  CreatorAgreement[]
  feedback                          Feedback[]
  finance                           Finance?
  invoice                           Invoice[]                          @relation("CreatedBy")
  leaderboardSnapshots              LeaderboardSnapshot[]
  createdLogistics                  Logistic[]                         @relation("CreatedLogistics")
  assignedLogistics                 Logistic[]                         @relation("AssignedLogistics")
  reportedIssues                    LogisticIssue[]
  sentMessages                      Message[]                          @relation("UserMessages")
  notifications                     Notification[]
  npsFeedback                       NpsFeedback[]
  paymentForm                       PaymentForm?
  photoFeedback                     Photo[]                            @relation("PhotoFeedback")
  photo                             Photo[]
  acceptedInviteByCreator           Pitch[]                            @relation("AcceptedInviteByCreator")
  approvedPitches                   Pitch[]                            @relation("ApprovedByClient")
  maybePitches                      Pitch[]                            @relation("MaybeByClient")
  rejectedPitches                   Pitch[]                            @relation("RejectedByClient")
  pitch                             Pitch[]
  pushTokens                        PushToken[]
  rawFootageFeedback                RawFootage[]                       @relation("RawFootageFeedback")
  rawFootage                        RawFootage[]
  releaseNotesCreated               ReleaseNote[]                      @relation("ReleaseNoteCreatedBy")
  resetPasswordToken                ResetPasswordToken?
  seenMessages                      SeenMessage[]
  shortlisted                       ShortListedCreator[]
  submission                        Submission[]
  forwardedComments                 SubmissionComment[]                @relation("ForwardedComments")
  resolvedComments                  SubmissionComment[]                @relation("ResolvedComments")
  submissionComments                SubmissionComment[]
  taskAssignee                      TaskAssignee[]
  createdTreasureHunts              TreasureHunt[]                     @relation("TreasureHuntCreatedBy")
  updatedTreasureHunts              TreasureHunt[]                     @relation("TreasureHuntUpdatedBy")
  treasureHuntAuditActions          TreasureHuntAuditLog[]
  treasureHuntClaims                TreasureHuntClaim[]
  unreadMessages                    UnreadMessage[]
  uploadSessions                    UploadSession[]
  emailVerifcation                  EmailVerification?                 @relation(fields: [emailVerificationId], references: [id])
  event                             Event?                             @relation(fields: [eventId], references: [id])
  userFlow                          UserFlow[]
  userNotification                  UserNotification[]
  UserThread                        UserThread[]
  xpBalance                         UserXpBalance?
  videoFeedback                     Video[]                            @relation("VideoFeedback")
  video                             Video[]
  xpTransactions                    XpTransaction[]
  aiModel                           AiModel?
  refreshTokens                     RefreshToken[]
  threads                           Thread[]                           @relation("UserThreads")
}

model CampaignCreationDraft {
  id                    String                             @id
  ownerId               String
  name                  String
  payload               Json
  activeStep            Int
  showAdditionalDetails Boolean
  revision              Int
  legacyFileStorage     Boolean                            @default(false)
  filesCleanupPending   Boolean                            @default(false)
  createdAt             DateTime                           @default(now())
  updatedAt             DateTime                           @updatedAt
  owner                 User                               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  uploadLeases          CampaignCreationDraftUploadLease[]

  @@index([ownerId, updatedAt])
}

model CampaignCreationDraftUploadLease {
  id             String                @id @default(uuid())
  draftId        String
  ownerId        String
  expiresAt      DateTime
  objectUrl      String?
  cleanupPending Boolean               @default(false)
  releasedAt     DateTime?
  createdAt      DateTime              @default(now())
  draft          CampaignCreationDraft @relation(fields: [draftId], references: [id])
  owner          User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([draftId, expiresAt])
  @@index([ownerId, draftId])
}

model PendingSocialSignup {
  id              String   @id @default(cuid())
  provider        String   @db.VarChar(16)
  providerSubject String   @db.VarChar(255)
  email           String   @db.VarChar(255)
  name            String?  @db.VarChar(255)
  appleAudience   String?  @db.VarChar(255)
  tokenHash       String   @unique @db.VarChar(64)
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([provider, providerSubject])
  @@index([expiresAt])
  @@map("pending_social_signups")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailVerification {
  id         String    @id @unique @default(cuid())
  shortCode  String
  token      String
  expiredAt  DateTime
  attempts   Int?      @default(0)
  lastSendAt DateTime? @default(now())
  user       User?
}

model ResetPasswordToken {
  id        String    @id @unique @default(cuid())
  token     String?
  userId    String?   @unique
  used      Boolean   @default(false)
  createdAt DateTime  @default(now())
  attempts  Int       @default(0)
  expiresAt DateTime?
  user      User?     @relation(fields: [userId], references: [id])
}

model Admin {
  id                    String                  @id @unique @default(cuid())
  mode                  Mode                    @default(normal)
  inviteToken           String?                 @unique
  userId                String                  @unique
  roleId                String?
  xeroTokenSet          Json?
  bdInviteToken         String?                 @unique
  role                  Role?                   @relation(fields: [roleId], references: [id])
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminLogs             AdminLog[]              @relation("AdminToAdminLog")
  adminPermissionModule AdminPermissionModule[]
  campaignAdmin         CampaignAdmin[]
  completedAgreements   CreatorAgreement[]      @relation("CompletedByAdmin")
  adminCommentedPitches Pitch[]                 @relation("AdminCommenter")
  approvedPitches       Pitch[]                 @relation("ApprovedByAdmin")
  rejectedPitches       Pitch[]                 @relation("RejectedByAdmin")
  approvedSubmissions   Submission[]            @relation("ApprovedByAdmin")
  submittedSubmissions  Submission[]            @relation("SubmittedByAdmin")
}

model Client {
  id                  String               @id @unique @default(cuid())
  userId              String               @unique
  companyId           String?
  inviteToken         String?              @unique
  clientType          ClientType           @default(directClient)
  createdAt           DateTime             @default(now())
  isActive            Boolean              @default(true)
  updatedAt           DateTime             @default(now()) @updatedAt
  isParentAccount     Boolean              @default(false)
  parentClientId      String?
  demoAccessToken     String?              @unique
  campaignClients     CampaignClient[]
  childAccounts       ChildAccount[]
  company             Company?             @relation(fields: [companyId], references: [id])
  parentClient        Client?              @relation("ParentChildClients", fields: [parentClientId], references: [id])
  childClients        Client[]             @relation("ParentChildClients")
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientNotifications ClientNotification[]
}

model ClientNotification {
  id        String   @id @unique @default(cuid())
  clientId  String
  title     String
  message   String
  entity    Entity?
  entityId  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ChildAccount {
  id              String    @id @unique @default(cuid())
  email           String
  password        String?
  firstName       String?
  lastName        String?
  isActive        Boolean   @default(false)
  invitedAt       DateTime  @default(now())
  activatedAt     DateTime?
  parentClientId  String
  invitationToken String?   @unique
  tokenExpiresAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  parentClient    Client    @relation(fields: [parentClientId], references: [id], onDelete: Cascade)

  @@unique([email, parentClientId])
}

model Role {
  id          String       @id @unique @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  slug        String?      @unique
  admin       Admin[]
  permissions Permisions[] @relation("RolePermission")
}

model Permisions {
  id           String   @id @unique @default(cuid())
  name         String   @unique
  descriptions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  role         Role[]   @relation("RolePermission")
}

model Creator {
  id                            String                    @id @unique @default(cuid())
  pronounce                     String?                   @db.VarChar(100)
  address                       String?
  state                         String?
  location                      String?
  birthDate                     DateTime?
  instagram                     String?                   @db.VarChar(100)
  tiktok                        String?                   @db.VarChar(100)
  employment                    Employment?               @default(others)
  languages                     Json?
  userId                        String                    @unique
  socialMediaData               Json?
  isFormCompleted               Boolean?
  xeroContactId                 String?
  industries                    Json?
  allowToChange                 Boolean                   @default(false)
  socialMediaUpdateCount        Json?
  instagramData                 Json?
  tiktokData                    Json?
  isFacebookConnected           Boolean                   @default(false)
  isTiktokConnected             Boolean                   @default(false)
  isOnBoardingFormCompleted     Boolean?
  isGuest                       Boolean                   @default(false)
  profileLink                   String?
  instagramProfileLink          String?                   @db.VarChar(255)
  tiktokProfileLink             String?                   @db.VarChar(255)
  city                          String?                   @db.VarChar(100)
  country                       String?
  dietaryRestrictions           String?
  postcode                      String?                   @db.VarChar(20)
  creditTierId                  String?
  manualFollowerCount           Int?                      @default(0)
  tierUpdatedAt                 DateTime?
  formCompletedAt               DateTime?
  manualInstagramFollowerCount  Int?                      @default(0)
  manualTiktokFollowerCount     Int?                      @default(0)
  /// Canonical guest identity, for example `instagram:example`. Derived from
  /// profileLink by profileUrlNormalizer. Unique, so two requests can never
  /// create two guest identities for the same creator. Null for a platform
  /// creator, or for a legacy guest that is part of an unresolved conflict.
  guestProfileKey               String?                   @unique @db.VarChar(120)
  /// Engagement rate for a creator with no connected account, as a percentage
  /// ("4.27" is 4.27%). Written by a Bright Data scrape or by an admin override in
  /// the Add Platform Creators modal. `Float?` matches
  /// InstagramUser.engagement_rate and TiktokUser.engagement_rate, so every
  /// read site sees one type. Null means never measured; it is not zero.
  manualInstagramEngagementRate Float?
  manualTiktokEngagementRate    Float?
  creditTier                    CreditTier?               @relation("UserCurrentTier", fields: [creditTierId], references: [id])
  user                          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  discoveryProfiles             CreatorDiscoveryProfile[]
  instagramUser                 InstagramUser?
  interests                     Interest[]
  invoices                      Invoice[]
  mediaKit                      MediaKit?
  tiktokUser                    TiktokUser?

  @@index([formCompletedAt])
}

model TiktokUser {
  id              String        @id @unique @default(cuid())
  creatorId       String        @unique
  display_name    String?
  avatar_url      String?
  following_count Int?
  follower_count  Int?
  likes_count     Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  averageComments Float?
  averageLikes    Float?
  engagement_rate Float?
  lastUpdated     DateTime?
  totalComments   Int?
  totalLikes      Int?
  averageShares   Float?
  totalShares     Int?
  username        String?
  biography       String?
  analyticsData   Json?
  creator         Creator       @relation(fields: [creatorId], references: [id])
  tiktokVideo     TiktokVideo[]
}

model TiktokVideo {
  id              String      @id @unique @default(cuid())
  video_id        String?     @unique
  cover_image_url String?
  title           String?
  description     String?
  duration        Float?
  embed_link      String?
  embed_html      String?
  like_count      Int?
  comment_count   Int?
  share_count     Int?
  view_count      Int?
  tiktokUserId    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tiktokUser      TiktokUser? @relation(fields: [tiktokUserId], references: [id])
}

model InstagramUser {
  id                  String           @id @unique @default(cuid())
  creatorId           String           @unique
  user_id             String?          @unique
  followers_count     Int?
  follows_count       Int?
  media_count         Int?
  username            String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  accessToken         Json?
  expiresIn           Int?
  averageComments     Float?
  averageLikes        Float?
  totalComments       Int?
  totalLikes          Int?
  engagement_rate     Float?
  lastUpdated         DateTime?
  averageSaves        Float?
  averageShares       Float?
  biography           String?
  insightData         Json?
  profile_picture_url String?
  totalSaves          Int?
  totalShares         Int?
  creator             Creator          @relation(fields: [creatorId], references: [id])
  instagramVideo      InstagramVideo[]
}

model InstagramVideo {
  id              String         @id @unique @default(cuid())
  video_id        String?        @unique
  comments_count  Int?
  like_count      Int?
  media_type      String?
  media_url       String?
  thumbnail_url   String?
  caption         String?
  permalink       String?
  instagramUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  datePosted      DateTime?
  shortCode       String?
  view_count      Int?
  instagramUser   InstagramUser? @relation(fields: [instagramUserId], references: [id])
}

model MediaKit {
  id          String  @id @unique @default(cuid())
  about       String?
  creatorId   String  @unique
  displayName String?
  creator     Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model Message {
  id             Int             @id @default(autoincrement())
  content        String
  createdAt      DateTime        @default(now())
  threadId       String?
  senderId       String?
  file           String?
  fileType       String?
  deletedAt      DateTime?
  deletedById    String?
  editedAt       DateTime?
  fileHeight     Int?
  fileName       String?
  fileSize       Int?
  fileWidth      Int?
  replyToId      Int?
  replyTo        Message?        @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]       @relation("MessageReplies")
  sender         User?           @relation("UserMessages", fields: [senderId], references: [id])
  thread         Thread?         @relation(fields: [threadId], references: [id])
  seenMessages   SeenMessage[]
  threadLatest   Thread?         @relation("LatestMessage")
  unreadMessages UnreadMessage[]
}

model UnreadMessage {
  id        Int     @id @default(autoincrement())
  userId    String
  threadId  String
  messageId Int
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  thread    Thread  @relation(fields: [threadId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@unique([userId, threadId, messageId])
}

model SeenMessage {
  id        Int       @id @default(autoincrement())
  userId    String
  messageId Int
  seenAt    DateTime?
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, messageId])
}

model Thread {
  id              String          @id @unique @default(cuid())
  title           String
  description     String
  photoURL        String?         @db.VarChar(255)
  isGroup         Boolean         @default(true)
  campaignId      String?         @unique
  latestMessageId Int?            @unique
  messages        Message[]
  campaign        Campaign?       @relation(fields: [campaignId], references: [id])
  latestMessage   Message?        @relation("LatestMessage", fields: [latestMessageId], references: [id])
  unreadMessages  UnreadMessage[]
  UserThread      UserThread[]
  users           User[]          @relation("UserThreads")
}

model UserThread {
  userId   String
  threadId String
  archived Boolean @default(false)
  thread   Thread  @relation(fields: [threadId], references: [id])
  user     User    @relation(fields: [userId], references: [id])

  @@id([userId, threadId])
}

model Interest {
  id      String  @id @unique @default(cuid())
  name    String?
  rank    Int?
  userId  String
  creator Creator @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model Finance {
  id     String @id @unique @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model Event {
  id          String     @id @unique @default(cuid())
  title       String?
  description String?
  color       String?
  allDay      Boolean
  userId      String
  start       DateTime
  end         DateTime
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  Campaign    Campaign[]
  user        User[]
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model Company {
  id                  String                @id @unique @default(cuid())
  name                String
  email               String?
  phone               String?
  website             String?
  address             String?
  logo                String?
  about               String?
  objectives          Json?
  registration_number String?               @db.VarChar(150)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  clientId            String?               @unique @default(cuid())
  type                CompanyType?
  archivedAt          DateTime?
  isArchived          Boolean               @default(false)
  blockedBy           BlockedBrand[]
  brand               Brand[]
  campaign            Campaign[]
  clients             Client[]
  pic                 Pic[]
  subscriptions       Subscription[]
  SubscriptionHistory SubscriptionHistory[]

  @@index([clientId])
}

model Pic {
  id          String   @id @unique @default(cuid())
  name        String
  designation String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   String?
  brandId     String?
  email       String?
  brand       Brand?   @relation(fields: [brandId], references: [id])
  company     Company? @relation(fields: [companyId], references: [id])
}

model Brand {
  id           String     @id @unique @default(cuid())
  name         String     @db.VarChar(100)
  email        String?    @db.VarChar(255)
  phone        String?    @db.VarChar(255)
  website      String?    @db.VarChar(255)
  logo         String?    @db.VarChar(255)
  description  String?    @db.VarChar(255)
  service_name String?    @db.VarChar(255)
  instagram    String?    @db.VarChar(255)
  tiktok       String?    @db.VarChar(255)
  facebook     String?    @db.VarChar(255)
  objectives   Json?
  industries   Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  campaign     Campaign[]
  pic          Pic[]
  supBrand     SupBrand[]
}

model SupBrand {
  id                  String        @id @unique @default(cuid())
  name                String        @db.VarChar(255)
  email               String?       @db.VarChar(255)
  phone               String?       @db.VarChar(255)
  tiktok              String?       @db.VarChar(255)
  instagram           String?       @db.VarChar(255)
  website             String?       @db.VarChar(255)
  logo                String?       @db.VarChar(255)
  registration_number String        @unique
  description         String?       @db.VarChar(255)
  service_name        String?       @db.VarChar(255)
  facebook            String?       @db.VarChar(255)
  intersets           Json?
  industries          Json?
  objectives          Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  brandId             String
  brand               Brand         @relation(fields: [brandId], references: [id])
  supSupBrand         SupSupBrand[]
}

model SupSupBrand {
  id                  String   @id @unique @default(cuid())
  name                String   @db.VarChar(255)
  email               String?  @db.VarChar(255)
  phone               String?  @db.VarChar(255)
  tiktok              String?  @db.VarChar(255)
  instagram           String?  @db.VarChar(255)
  facebook            String?  @db.VarChar(255)
  website             String?  @db.VarChar(255)
  service_name        String?  @db.VarChar(255)
  registration_number String   @unique
  logo                String?  @db.VarChar(255)
  description         String?  @db.VarChar(255)
  objectives          Json?
  intersets           Json?
  industries          Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  supBrandId          String
  supBrand            SupBrand @relation(fields: [supBrandId], references: [id])
}

model Campaign {
  id                            String                          @id @unique @default(cuid())
  name                          String
  description                   String
  status                        CampaignStatus                  @default(SCHEDULED)
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
  brandId                       String?
  companyId                     String?
  brandTone                     String?
  productName                   String?
  eventId                       String?
  spreadSheetURL                String?
  agreementTemplateId           String?
  campaignType                  String?                         @default("normal")
  rawFootage                    Boolean                         @default(false)
  ads                           Boolean                         @default(false)
  campaignCredits               Int?
  campaignId                    String?
  photos                        Boolean                         @default(false)
  creditsPending                Int?
  creditsUtilized               Int?
  subscriptionId                String?
  crossPosting                  Boolean                         @default(false)
  isKWSPCampaign                Boolean?                        @default(false)
  origin                        CampaignOrigin                  @default(ADMIN)
  submissionVersion             String?                         @default("v4")
  logisticsType                 LogisticType?
  brandAbout                    String?
  websiteLink                   String?
  isCreditTier                  Boolean                         @default(false)
  isPCRReady                    Boolean                         @default(false)
  completedAt                   DateTime?
  publishedAt                   DateTime?
  isForSurfShark                Boolean?
  creditAllocationBreakdown     Json?
  bdInviteToken                 String?
  approvedAt                    DateTime?
  briefOwnerId                  String?
  clientBriefSnapshot           Json?
  clientEmail                   String?
  clientMagicToken              String?                         @unique
  clientName                    String?
  clientPackage                 String?
  clientTokenExpiresAt          DateTime?
  draftOrigin                   CampaignDraftOrigin?
  draftStatus                   CampaignDraftStatus?
  editedByClientFields          String[]                        @default([])
  handedOverAt                  DateTime?
  internalComments              String?
  sentToClientAt                DateTime?
  lostAmount                    Float?
  lostCurrency                  String?
  lostReason                    String?
  lostAt                        DateTime?
  wonAmount                     Float?
  wonCurrency                   String?
  brandName                     String?
  onHoldAt                      DateTime?
  isForMobile                   Boolean                         @default(false)
  summaryUrl                    String?
  isNdaRequired                 Boolean                         @default(false)
  approvalRequests              ApprovalRequest[]
  bookMarkCampaign              BookMarkCampaign[]
  agreementTemplate             AgreementTemplate?              @relation(fields: [agreementTemplateId], references: [id])
