  isInvited                 Boolean                   @default(false)
  /// From public approval link; shown only to brand client UI, not admin
  clientVisibleApprovalNote String?
  selectedPlatform          SocialPlatform?
  /// Set while a scrape job still owns Followers and ER for this pitch.
  pendingExtractionId       String?                   @unique
  /// Why that run gave no metrics, e.g. INSUFFICIENT_DATA. While set, an admin
  /// may enter Followers and ER by hand.
  metricsFailureCode        String?
  approvalRequestCreators   ApprovalRequestCreator[]
  guestCreatorMetricAudits  GuestCreatorMetricAudit[]
  Notification              Notification[]
  acceptedInviteByCreator   User?                     @relation("AcceptedInviteByCreator", fields: [acceptedInviteByCreatorId], references: [id])
  adminCommenter            Admin?                    @relation("AdminCommenter", fields: [adminCommentedBy], references: [userId])
  admin                     Admin?                    @relation("ApprovedByAdmin", fields: [approvedByAdminId], references: [userId])
  client                    User?                     @relation("ApprovedByClient", fields: [approvedByClientId], references: [id])
  campaign                  Campaign                  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  maybeByClient             User?                     @relation("MaybeByClient", fields: [maybeByClientId], references: [id])
  pendingExtraction         GuestProfileExtraction?   @relation("PendingPitchExtraction", fields: [pendingExtractionId], references: [id])
  rejectedByAdmin           Admin?                    @relation("RejectedByAdmin", fields: [rejectedByAdminId], references: [userId])
  rejectedByClient          User?                     @relation("RejectedByClient", fields: [rejectedByClientId], references: [id])
  user                      User                      @relation(fields: [userId], references: [id])

  @@unique([userId, campaignId])
}

