  items       ReleaseNoteItem[]

  @@index([status, publishedAt])
}

model ReleaseNoteItem {
  id            String              @id @default(cuid())
  releaseNoteId String
  type          ReleaseNoteItemType
  title         String              @db.VarChar(255)
  description   String
  order         Int                 @default(0)
  releaseNote   ReleaseNote         @relation(fields: [releaseNoteId], references: [id], onDelete: Cascade)

  @@index([releaseNoteId])
}

model ReimbursementReceipt {
  id              String              @id @default(cuid())
  agreementId     String
  userId          String
  campaignId      String
  round           Int
  order           Int
  fileUrl         String
  fileName        String
  mimeType        String
  amount          Float
  currency        String              @default("MYR")
  description     String
  status          ReimbursementStatus @default(DRAFT)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  financeNote     String?
  invoiceId       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  agreement       CreatorAgreement    @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([campaignId, userId, round])
  @@index([agreementId])
}

