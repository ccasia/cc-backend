/// One durable unit of provider work.
///
/// Written before the job is enqueued, so a restart can recover it. Holds
/// typed results only. Raw provider JSON is never persisted.
model GuestProfileExtraction {
  id                      String                       @id @default(cuid())
  campaignId              String
  /// The admin who started the work. Status and receipt access require this
  /// exact user. Not a relation, so a user record change never deletes work.
  requestedByUserId       String
  /// Canonical identity, for example `instagram:example`.
  canonicalProfileKey     String                       @db.VarChar(120)
  canonicalProfileUrl     String                       @db.VarChar(255)
  platform                SocialPlatform
  /// Column names predate the Bright Data migration (2026-09). Apify-era rows
  /// keep their Apify values.
  /// Bright Data posts dataset ID, for example `gd_lyclm20il4r5helnj`.
  actorId                 String                       @db.VarChar(120)
  /// Adapter contract version, for example `brightdata-ig-2026-09`. Keys the
  /// cache and the work fingerprint. Bright Data has no build pinning.
  actorBuild              String                       @db.VarChar(40)
  /// Posts job `snapshot_id` (`sd_...`). Both columns hold the same value.
  actorRunId              String?                      @db.VarChar(60)
  actorDatasetId          String?                      @db.VarChar(60)
  /// Profile job `snapshot_id`, on both platforms. It supplies followers and
  /// the private flag, and on Instagram the pinned flag and fallback dates.
  /// Recorded before polling, so a paid job is never untracked.
  profileActorRunId       String?                      @db.VarChar(60)
  profileActorDatasetId   String?                      @db.VarChar(60)
  status                  GuestProfileExtractionStatus @default(QUEUED)
  resultName              String?                      @db.VarChar(255)
  resultFollowerCount     Int?
  /// Percentage without the sign. `"4.27"` means 4.27%.
  resultEngagementRate    String?                      @db.VarChar(24)
  sampleSize              Int?
  formulaVersion          String?                      @db.VarChar(60)
  /// Selected-post evidence built by this backend. Not provider JSON.
  selectedPosts           Json?
  /// Every candidate the provider returned, with the verdict the policy gave it.
  /// Counters, IDs and timestamps only. No caption, media URL, avatar or bio.
  candidatePosts          Json?
  /// Policy flags the provider did not report, plus `publishedAt` when an
  /// undated Instagram Reel was ordered by provider list order.
  unverifiedFlags         String[]
  failureCode             String?                      @db.VarChar(60)
  failureMessage          String?
  /// Start idempotency. The same key with a different body is a conflict.
  idempotencyKey          String                       @db.VarChar(120)
  requestFingerprint      String                       @db.VarChar(64)
  /// Receipt binding. The nonce is consumed inside the create transaction.
  receiptNonce            String?                      @unique @db.VarChar(64)
  receiptDigest           String?                      @db.VarChar(64)
  receiptExpiresAt        DateTime?
  receiptConsumedAt       DateTime?
  /// Measured charge from the provider. Apify-era rows only: Bright Data
  /// reports no per-job cost, so it stays null. Spend is in its dashboard.
  costUsd                 Decimal?                     @db.Decimal(10, 6)
  /// Measured charge for the profile run. Apify-era rows only.
  profileCostUsd          Decimal?                     @db.Decimal(10, 6)
  /// Set when this row copied a completed result instead of paying again.
  reusedFromExtractionId  String?
  /// Starts refused because the same work was already running or already
  /// done. A high number means the browser is asking twice.
  duplicateStartAttempts  Int                          @default(0)
  reconcileAttempts       Int                          @default(0)
  lastReconciledAt        DateTime?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  startedAt               DateTime?
  completedAt             DateTime?
  /// Cleanup boundary. Removing a row here must never remove an audit.
  expiresAt               DateTime?
  /// Typed result. Present only for READY.
  resultBiography         String?
  /// Profile picture copied to our storage. Provider CDN links expire. Set on
  /// READY and INSUFFICIENT_DATA, because the profile job worked on both.
  resultProfilePictureUrl String?
  /// Second posts job (`snapshot_id`), started only when the first batch had
  /// too few usable posts. Recorded before polling, so a paid job is never
  /// untracked. Null when one batch was enough.
  topUpRunId              String?                      @db.VarChar(60)
  metricAudits            GuestCreatorMetricAudit[]
  campaign                Campaign                     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  pendingPitches          Pitch?                       @relation("PendingPitchExtraction")

  @@unique([requestedByUserId, idempotencyKey])
  @@index([canonicalProfileKey, platform, actorBuild, status])
  @@index([requestedByUserId, status])
  @@index([campaignId, status])
  @@index([status, updatedAt])
  @@index([expiresAt])
  @@index([completedAt])
}

/// Provenance for every guest metric written to a Pitch.
///
/// Denormalized on purpose. It must stay readable after the extraction row is
/// cleaned up, so the extraction link is optional and set to null on delete.
model CreatorDiscoveryProfile {
  biography             String?
  id                    String             @id @default(cuid())
  userId                String
  platform              SocialPlatform
  profileUrl            String?
  handle                String?
  followers             Int?
  engagementRate        Float?
  followersSource       GuestMetricSource?
  engagementRateSource  GuestMetricSource?
  followersSavedAt      DateTime?
  engagementRateSavedAt DateTime?
  savedAt               DateTime
  scrapedAt             DateTime?
  /// When this profile first joined Discovery. A re-scrape does not change it.
  createdAt             DateTime           @default(now())
  /// When Link Creator moved this scrape from a guest to a platform creator.
  linkedAt              DateTime?
  /// Durable, typed evidence. Independent of temporary extractions and manual values.
  scrapeDetails         Json?
  /// Caption search without loading full post evidence for every candidate.
  captions              String             @default("")
  creator               Creator            @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([platform])
}

model GuestCreatorMetricAudit {
  id                     String                  @id @default(cuid())
  pitchId                String
  extractionId           String?
  /// The guest User the pitch belongs to.
  guestUserId            String?
  canonicalProfileKey    String?                 @db.VarChar(120)
  platform               SocialPlatform?
  /// What the fetch produced. Null when there was no fetch.
  originalName           String?                 @db.VarChar(255)
  originalFollowerCount  Int?
  originalEngagementRate String?                 @db.VarChar(24)
  /// What was saved.
  finalName              String?                 @db.VarChar(255)
  finalFollowerCount     Int?
  finalEngagementRate    String?                 @db.VarChar(24)
  source                 GuestMetricSource
  overrideReason         String?
  /// Copied from the extraction so cleanup cannot erase it.
  actorId                String?                 @db.VarChar(120)
  actorBuild             String?                 @db.VarChar(40)
  actorRunId             String?                 @db.VarChar(60)
  formulaVersion         String?                 @db.VarChar(60)
  /// The authenticated admin who made the request.
  performedByUserId      String
  /// The admin who reviewed the values, when that differs.
  reviewerUserId         String?
  createdAt              DateTime                @default(now())
  extraction             GuestProfileExtraction? @relation(fields: [extractionId], references: [id])
  pitch                  Pitch                   @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  @@index([pitchId])
  @@index([extractionId])
  @@index([canonicalProfileKey])
  @@index([performedByUserId, createdAt])
}

/// Database idempotency for the final create call.
///
/// The same key with the same body returns the saved response. The same key
/// with a different body is a conflict.
model GuestCreatorCreateRequest {
  id                String                   @id @default(cuid())
  /// Scoped to the authenticated actor and the operation, never global.
  performedByUserId String                   @db.VarChar(60)
  operation         String                   @db.VarChar(60)
  idempotencyKey    String                   @db.VarChar(120)
  campaignId        String
  /// Hash of the normalized request body.
  requestHash       String                   @db.VarChar(64)
  status            GuestCreateRequestStatus @default(IN_PROGRESS)
  /// Saved response, replayed for a repeated key.
  responseStatus    Int?
  responseBody      Json?
  resultPitchIds    String[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  completedAt       DateTime?
  expiresAt         DateTime?
  campaign          Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([performedByUserId, operation, idempotencyKey])
  @@index([campaignId])
  @@index([expiresAt])
}

/// A legacy group of guest creators that share one canonical identity.
///
/// Created by the backfill. While UNRESOLVED it blocks both extraction and
/// creation for that key. A conflicting key is never set to null so that a
/// duplicate can be created instead.
model GuestProfileIdentityConflict {
  id                  String                      @id @default(cuid())
  canonicalProfileKey String                      @unique @db.VarChar(120)
  platform            SocialPlatform
  /// Every Creator and User record in the conflicting group.
  creatorIds          String[]
  userIds             String[]
  /// The raw profileLink values that produced the same canonical key.
  profileLinks        String[]
  status              GuestIdentityConflictStatus @default(UNRESOLVED)
  detectedAt          DateTime                    @default(now())
  resolvedAt          DateTime?
  resolvedByUserId    String?
  resolutionNote      String?

  @@index([status])
}

model ReleaseNote {
  id          String            @id @default(cuid())
  releaseDate DateTime
  status      ReleaseNoteStatus @default(DRAFT)
  publishedAt DateTime?
  createdById String?
  createdAt   DateTime          @default(now())
